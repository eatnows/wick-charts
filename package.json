{
  "name": "cinder-charts",
  "version": "0.0.1",
  "description": "An open-source financial charting library — WASM (Rust) for compute, Canvas2D for rendering.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:wasm": "wasm-pack build crates/cinderchart-core --target web --out-dir ../../wasm-pkg --out-name cinderchart_core",
    "demo": "pnpm build:wasm && pnpm build && python3 -m http.server 4173",
    "test": "vitest run",
    "test:rust": "cargo test",
    "check:rust": "cargo check --target wasm32-unknown-unknown -p cinderchart-core"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
